[
  {
    "baseURL": "/authentication/login",
    "proxy": {
      "targets": [
        {
          "url": "http://localhost:4001",
          "weight": 15
        },
        {
          "url": "http://localhost:4002",
          "weight": 5
        },
        {
          "url": "http://localhost:4003",
          "weight": 6
        }
      ],
      "strategy": "sticky",
      "stickyKey": "ip",
      "changeOrigin": true,
      "ws": false
    },
    "auth": {
      "enabled": true,
      "strategy": "apiKey",
      "header": "x-api-key",
      "keys": [
        ""
      ],
      "authRateLimit": {
        "max": 5,
        "windowMs": 60000
      }
    },
    "circuitBreaker": {
      "threshold": 5,
      "timeout": 30000
    }
  },
  {
    "baseURL": "/new-route",
    "proxy": {
      "target": "http://localhost:4000",
      "changeOrigin": true
    },
    "ipFilter": {
      "deny": [
        "192.0.2.1"
      ]
    }
  }
]
