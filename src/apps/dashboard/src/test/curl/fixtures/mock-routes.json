[
  {
    "baseURL": "/mock/catalog",
    "proxy": {
      "target": "http://localhost:4100",
      "changeOrigin": true,
      "timeout": 5000
    },
    "rateLimit": {
      "max": 100,
      "windowMs": 60000,
      "keyBy": "ip"
    },
    "cache": {
      "ttl": 30000,
      "methods": ["GET"],
      "statusCodes": [200]
    }
  },
  {
    "baseURL": "/mock/orders",
    "proxy": {
      "targets": [
        { "url": "http://localhost:4201", "weight": 2 },
        { "url": "http://localhost:4202", "weight": 1 }
      ],
      "strategy": "weighted",
      "changeOrigin": true
    },
    "auth": {
      "enabled": true,
      "strategy": "apiKey",
      "header": "x-api-key",
      "keys": ["mock-dashboard-test-key"]
    },
    "retry": {
      "attempts": 2,
      "delay": 100,
      "backoff": "fixed",
      "retryOn": [502, 503, 504]
    }
  }
]

