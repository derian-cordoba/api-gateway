# Path is resolved from src/apps/dashboard when using the dashboard scripts.
ROUTES_FILE_PATH=../../../routes.json

# Set this in shared or remote environments. Local development may leave it empty.
DASHBOARD_TOKEN=


# Route storage: local-json (compatibility), sqlite, postgres, mongodb.
# Configure the same driver/key/profile in the gateway and Dashboard.
ROUTE_STORAGE_DRIVER=local-json
ROUTE_CONFIGURATION_KEY=default
ROUTE_HISTORY_LIMIT=50
ROUTE_STORAGE_POLL_INTERVAL_MS=2000
# SQLite uses one absolute path; there is no dev/prod profile.
# ROUTE_SQLITE_PATH=/absolute/path/to/data/routes.sqlite
# Required only for PostgreSQL or MongoDB, independently of NODE_ENV:
# ROUTE_DATABASE_ENV=development
# ROUTE_DATABASE_POOL_SIZE=5
# ROUTE_POSTGRES_DEVELOPMENT_URL=postgresql://gateway:password@localhost:5432/gateway_dev
# ROUTE_POSTGRES_PRODUCTION_URL=postgresql://gateway:password@db:5432/gateway_prod
# ROUTE_MONGODB_DEVELOPMENT_URI=mongodb://localhost:27017/?replicaSet=rs0
# ROUTE_MONGODB_DEVELOPMENT_DATABASE=gateway_dev
# ROUTE_MONGODB_PRODUCTION_URI=mongodb+srv://gateway:password@cluster.example/
# ROUTE_MONGODB_PRODUCTION_DATABASE=gateway_prod

# Optional named sources: must match gateway profiles and connection references.
# ROUTE_SOURCE_PROFILES='[{"id":"preview","name":"Preview routes","driver":"sqlite","connectionEnv":"PREVIEW_SQLITE_PATH","configurationKey":"preview"}]'
# PREVIEW_SQLITE_PATH=/absolute/path/to/data/preview.sqlite
# Server-only connection for live source status and activation.
# GATEWAY_MANAGEMENT_URL=http://localhost:3000/management
# GATEWAY_MANAGEMENT_TOKEN=your-management-token
# See docs/dashboard-route-sources.md for gateway control database setup.

# Dashboard discovers configured storage drivers from the standard ROUTE_SQLITE_PATH,
# ROUTE_POSTGRES_<ENV>_URL, and ROUTE_MONGODB_<ENV>_URI/DATABASE variables.
# ROUTE_SOURCE_PROFILES is only needed for additional named connections/keys.
