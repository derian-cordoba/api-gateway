[
  {
    "baseURL": "/users",
    "proxy": {
      "target": "http://localhost:4001",
      "changeOrigin": true,
      "pathRewrite": { "^/users": "" }
    },
    "rateLimit": {
      "max": 10,
      "windowMs": 60000,
      "statusCode": 429,
      "message": "Too many requests to the users service. Try again in a minute."
    }
  },
  {
    "baseURL": "/products",
    "proxy": {
      "target": "http://localhost:4002",
      "changeOrigin": true,
      "pathRewrite": { "^/products": "" }
    },
    "rateLimit": {
      "max": 20,
      "windowMs": 60000,
      "statusCode": 429,
      "message": "Too many requests to the products service. Try again in a minute."
    }
  },
  {
    "baseURL": "/auth",
    "proxy": {
      "target": "http://localhost:4003",
      "changeOrigin": true,
      "pathRewrite": { "^/auth": "" }
    }
  },
  {
    "baseURL": "/orders",
    "proxy": {
      "target": "http://localhost:4004",
      "changeOrigin": true,
      "pathRewrite": { "^/orders": "" }
    },
    "auth": {
      "enabled": true,
      "strategy": "jwt"
    }
  },
  {
    "baseURL": "/reports",
    "proxy": {
      "target": "http://localhost:4005",
      "changeOrigin": true,
      "pathRewrite": { "^/reports": "" }
    },
    "auth": {
      "enabled": true,
      "strategy": "apiKey",
      "header": "x-api-key",
      "keys": ["key-service-alpha-123", "key-service-beta-456"]
    }
  },
  {
    "baseURL": "/payments",
    "proxy": {
      "target": "http://localhost:4006",
      "changeOrigin": true,
      "pathRewrite": { "^/payments": "" }
    },
    "circuitBreaker": {
      "threshold": 3,
      "timeout": 10000,
      "successThreshold": 1
    }
  },
  {
    "baseURL": "/inventory",
    "proxy": {
      "target": "http://localhost:4007",
      "changeOrigin": true,
      "pathRewrite": { "^/inventory": "" }
    }
  },
  {
    "baseURL": "/analytics/public",
    "proxy": {
      "target": "http://localhost:4008",
      "changeOrigin": true,
      "pathRewrite": { "^/analytics/public": "" }
    }
  },
  {
    "baseURL": "/analytics/internal",
    "proxy": {
      "target": "http://localhost:4008",
      "changeOrigin": true,
      "pathRewrite": { "^/analytics/internal": "" }
    },
    "ipFilter": {
      "allow": ["127.0.0.1"]
    }
  },
  {
    "baseURL": "/catalog",
    "proxy": {
      "targets": [
        { "url": "http://localhost:4010" },
        { "url": "http://localhost:4011", "weight": 2 },
        { "url": "http://localhost:4012" }
      ],
      "strategy": "round-robin",
      "changeOrigin": true,
      "pathRewrite": { "^/catalog": "" }
    }
  },
  {
    "baseURL": "/chat",
    "proxy": {
      "target": "http://localhost:4020",
      "changeOrigin": true,
      "pathRewrite": { "^/chat": "" },
      "ws": true
    }
  },
  {
    "baseURL": "/retry-inventory",
    "proxy": {
      "target": "http://localhost:4040",
      "changeOrigin": true,
      "pathRewrite": { "^/retry-inventory": "" }
    },
    "retry": {
      "attempts": 3,
      "delay": 200,
      "backoff": "exponential"
    }
  },
  {
    "baseURL": "/cached-catalog",
    "proxy": {
      "target": "http://localhost:4050",
      "changeOrigin": true,
      "pathRewrite": { "^/cached-catalog": "" }
    },
    "cache": {
      "ttl": 30000,
      "methods": ["GET", "HEAD"],
      "statusCodes": [200]
    }
  },
  {
    "baseURL": "/metrics-orders",
    "proxy": {
      "target": "http://localhost:4030",
      "changeOrigin": true,
      "pathRewrite": { "^/metrics-orders": "" }
    },
    "cache": {
      "ttl": 10000,
      "methods": ["GET"]
    }
  }
]
