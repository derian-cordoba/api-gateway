[
  {
    "baseURL": "/users",
    "proxy": {
      "target": "http://localhost:4001",
      "changeOrigin": true,
      "pathRewrite": {
        "^/users": ""
      }
    },
    "rateLimit": {
      "max": 10,
      "windowMs": 60000,
      "statusCode": 429,
      "message": "Too many requests to the users service. Try again in a minute."
    }
  },
  {
    "baseURL": "/products",
    "proxy": {
      "target": "http://localhost:4002",
      "changeOrigin": true,
      "pathRewrite": {
        "^/products": ""
      }
    },
    "rateLimit": {
      "max": 20,
      "windowMs": 60000,
      "statusCode": 429,
      "message": "Too many requests to the products service. Try again in a minute."
    }
  },
  {
    "baseURL": "/auth",
    "proxy": {
      "target": "http://localhost:4003",
      "changeOrigin": true,
      "pathRewrite": {
        "^/auth": ""
      }
    }
  },
  {
    "baseURL": "/orders",
    "proxy": {
      "target": "http://localhost:4004",
      "changeOrigin": true,
      "pathRewrite": {
        "^/orders": ""
      }
    },
    "auth": {
      "enabled": true,
      "strategy": "jwt",
      "secret": "super-secret-key-change-in-production"
    }
  },
  {
    "baseURL": "/reports",
    "proxy": {
      "target": "http://localhost:4005",
      "changeOrigin": true,
      "pathRewrite": {
        "^/reports": ""
      }
    },
    "auth": {
      "enabled": true,
      "strategy": "apiKey",
      "header": "x-api-key",
      "keys": [
        "key-service-alpha-123",
        "key-service-beta-456"
      ]
    }
  },
  {
    "baseURL": "/payments",
    "proxy": {
      "target": "http://localhost:4006",
      "changeOrigin": true,
      "pathRewrite": {
        "^/payments": ""
      }
    },
    "circuitBreaker": {
      "threshold": 3,
      "timeout": 10000,
      "successThreshold": 1
    }
  },
  {
    "baseURL": "/inventory",
    "proxy": {
      "target": "http://localhost:4007",
      "changeOrigin": true,
      "pathRewrite": {
        "^/inventory": ""
      }
    }
  },
  {
    "baseURL": "/analytics/public",
    "proxy": {
      "target": "http://localhost:4008",
      "changeOrigin": true,
      "pathRewrite": {
        "^/analytics/public": ""
      }
    }
  },
  {
    "baseURL": "/analytics/internal",
    "proxy": {
      "target": "http://localhost:4008",
      "changeOrigin": true,
      "pathRewrite": {
        "^/analytics/internal": ""
      }
    },
    "ipFilter": {
      "allow": [
        "127.0.0.1"
      ]
    }
  },
  {
    "baseURL": "/catalog",
    "proxy": {
      "targets": [
        {
          "url": "http://localhost:4010"
        },
        {
          "url": "http://localhost:4011",
          "weight": 2
        },
        {
          "url": "http://localhost:4012"
        }
      ],
      "strategy": "round-robin",
      "changeOrigin": true,
      "pathRewrite": {
        "^/catalog": ""
      }
    }
  },
  {
    "baseURL": "/chat",
    "proxy": {
      "target": "http://localhost:4020",
      "changeOrigin": true,
      "pathRewrite": {
        "^/chat": ""
      },
      "ws": true
    }
  },
  {
    "baseURL": "/retry-inventory",
    "proxy": {
      "target": "http://localhost:4040",
      "changeOrigin": true,
      "pathRewrite": {
        "^/retry-inventory": ""
      }
    },
    "retry": {
      "attempts": 3,
      "delay": 200,
      "backoff": "exponential"
    }
  },
  {
    "baseURL": "/cached-catalog",
    "proxy": {
      "target": "http://localhost:4050",
      "changeOrigin": true,
      "pathRewrite": {
        "^/cached-catalog": ""
      }
    },
    "cache": {
      "ttl": 30000,
      "methods": [
        "GET",
        "HEAD"
      ],
      "statusCodes": [
        200
      ]
    }
  },
  {
    "baseURL": "/metrics-orders",
    "proxy": {
      "target": "http://localhost:4030",
      "changeOrigin": true,
      "pathRewrite": {
        "^/metrics-orders": ""
      }
    },
    "cache": {
      "ttl": 10000,
      "methods": [
        "GET"
      ]
    }
  },
  {
    "baseURL": "/echo",
    "proxy": {
      "target": "http://localhost:4060",
      "changeOrigin": true,
      "pathRewrite": {
        "^/echo": ""
      }
    },
    "headers": {
      "request": {
        "set": {
          "X-Forwarded-By": "api-gateway",
          "X-Api-Version": "2",
          "X-Internal-Token": "secret-internal-value"
        },
        "remove": [
          "user-agent"
        ]
      },
      "response": {
        "set": {
          "X-Frame-Options": "DENY",
          "X-Custom-Upstream": "overridden-by-gateway"
        },
        "remove": [
          "Server"
        ]
      }
    }
  },
  {
    "baseURL": "/public-api",
    "proxy": {
      "target": "http://localhost:4061",
      "changeOrigin": true,
      "pathRewrite": {
        "^/public-api": ""
      }
    }
  },
  {
    "baseURL": "/restricted-api",
    "proxy": {
      "target": "http://localhost:4061",
      "changeOrigin": true,
      "pathRewrite": {
        "^/restricted-api": ""
      }
    },
    "cors": {
      "origin": [
        "http://trusted.example.com",
        "https://trusted.example.com"
      ],
      "methods": [
        "GET",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "Content-Type",
        "Authorization"
      ],
      "maxAge": 3600
    }
  },
  {
    "baseURL": "/oauth2-auth",
    "proxy": {
      "target": "http://localhost:4062",
      "changeOrigin": true,
      "pathRewrite": {
        "^/oauth2-auth": ""
      }
    }
  },
  {
    "baseURL": "/oauth2-protected",
    "proxy": {
      "target": "http://localhost:4063",
      "changeOrigin": true,
      "pathRewrite": {
        "^/oauth2-protected": ""
      }
    },
    "headers": {
      "request": {
        "set": {
          "X-Forwarded-By": "api-gateway"
        }
      }
    },
    "auth": {
      "enabled": true,
      "strategy": "oauth2",
      "introspectionUrl": "http://localhost:4062/introspect",
      "clientId": "gateway-client",
      "clientSecret": "gw-s3cr3t"
    }
  },
  {
    "baseURL": "/basic-auth",
    "proxy": {
      "target": "http://localhost:4070",
      "pathRewrite": {
        "^/basic-auth": ""
      }
    },
    "auth": {
      "enabled": true,
      "strategy": "basicAuth",
      "credentials": [
        {
          "username": "alice",
          "password": "password123"
        }
      ],
      "authRateLimit": {
        "max": 5,
        "windowMs": 60000
      }
    }
  },
  {
    "baseURL": "/validated",
    "proxy": {
      "target": "http://localhost:4071",
      "pathRewrite": {
        "^/validated": ""
      }
    },
    "validation": {
      "requiredFields": [
        "name",
        "email"
      ],
      "allowedContentTypes": [
        "application/json"
      ],
      "maxBodyBytes": 1024
    }
  },
  {
    "baseURL": "/webhooks/github",
    "proxy": {
      "target": "http://localhost:4072",
      "pathRewrite": {
        "^/webhooks/github": ""
      }
    },
    "webhook": {
      "provider": "github",
      "secret": "example-webhook-secret"
    }
  },
  {
    "baseURL": "/webhooks/stripe",
    "proxy": {
      "target": "http://localhost:4072",
      "pathRewrite": {
        "^/webhooks/stripe": ""
      }
    },
    "webhook": {
      "provider": "stripe",
      "secret": "example-webhook-secret"
    }
  },
  {
    "baseURL": "/webhooks/custom",
    "proxy": {
      "target": "http://localhost:4072",
      "pathRewrite": {
        "^/webhooks/custom": ""
      }
    },
    "webhook": {
      "provider": "custom",
      "secret": "example-webhook-secret",
      "headerName": "x-example-signature",
      "hashAlgorithm": "sha256"
    }
  },
  {
    "baseURL": "/slow",
    "proxy": {
      "target": "http://localhost:4073",
      "pathRewrite": {
        "^/slow": ""
      },
      "timeout": 100
    }
  },
  {
    "baseURL": "/signed",
    "retry": { "attempts": 1, "delay": 0 },
    "proxy": {
      "target": "http://localhost:4074",
      "pathRewrite": {
        "^/signed": ""
      },
      "upstreamAuth": {
        "type": "hmac-sha256",
        "secret": "example-upstream-secret"
      }
    }
  },
  {
    "baseURL": "/mirrored",
    "retry": { "attempts": 1, "delay": 0 },
    "proxy": {
      "target": "http://localhost:4075",
      "pathRewrite": {
        "^/mirrored": ""
      },
      "mirror": {
        "target": "http://localhost:4076",
        "percentage": 100
      }
    }
  }
]
