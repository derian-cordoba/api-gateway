[
  {
    "baseURL": "/echo",
    "proxy": {
      "target": "http://localhost:4060",
      "changeOrigin": true,
      "pathRewrite": { "^/echo": "" }
    },
    "headers": {
      "request": {
        "set": {
          "X-Forwarded-By": "api-gateway",
          "X-Api-Version": "2",
          "X-Internal-Token": "secret-internal-value"
        },
        "remove": ["user-agent"]
      },
      "response": {
        "set": {
          "X-Frame-Options": "DENY",
          "X-Custom-Upstream": "overridden-by-gateway"
        },
        "remove": ["Server"]
      }
    }
  }
]
