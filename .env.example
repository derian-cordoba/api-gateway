# ── Server ───────────────────────────────────────────────────────────────────
# Port the gateway listens on. GATEWAY_PORT takes priority over PORT.
GATEWAY_PORT=3000

# Optional URL prefix mounted before all gateway routes.
# Example: GATEWAY_PREFIX=/api/v1  →  routes become /api/v1/<baseURL>
GATEWAY_PREFIX=

# Trust proxy headers for client IP detection. Use false, true, or a hop count.
TRUST_PROXY=false

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Set to "production" to disable pino-pretty and emit newline-delimited JSON.
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all origins.
CORS_ORIGINS=*

# Comma-separated list of allowed HTTP methods.
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Comma-separated list of allowed request headers.
CORS_HEADERS=Content-Type,Authorization

# ── Routes ───────────────────────────────────────────────────────────────────
# Path to the JSON file that defines proxy routes (relative to process cwd).
ROUTES_FILE_PATH=routes.json

# Inline route definitions as a JSON array (merged with ROUTES_FILE_PATH).
# Example: ROUTES=[{"baseURL":"/svc","proxy":{"target":"http://localhost:4000","changeOrigin":true}}]
ROUTES=

# ── Protected management API ────────────────────────────────────────────────
# Disabled by default. Set a long random token before enabling.
MANAGEMENT_ENABLED=false
MANAGEMENT_TOKEN=
MANAGEMENT_PREFIX=/management

# Route storage: local-json (compatibility), sqlite, postgres, mongodb.
# Configure the same driver/key/profile in the gateway and Dashboard.
ROUTE_STORAGE_DRIVER=local-json
ROUTE_CONFIGURATION_KEY=default
ROUTE_HISTORY_LIMIT=50
ROUTE_STORAGE_POLL_INTERVAL_MS=2000
# SQLite uses one absolute path; there is no dev/prod profile.
# ROUTE_SQLITE_PATH=/absolute/path/to/data/routes.sqlite
# Required only for PostgreSQL or MongoDB, independently of NODE_ENV:
# ROUTE_DATABASE_ENV=development
# ROUTE_DATABASE_POOL_SIZE=5
# ROUTE_POSTGRES_DEVELOPMENT_URL=postgresql://gateway:password@localhost:5432/gateway_dev
# ROUTE_POSTGRES_PRODUCTION_URL=postgresql://gateway:password@db:5432/gateway_prod
# ROUTE_MONGODB_DEVELOPMENT_URI=mongodb://localhost:27017/?replicaSet=rs0
# ROUTE_MONGODB_DEVELOPMENT_DATABASE=gateway_dev
# ROUTE_MONGODB_PRODUCTION_URI=mongodb+srv://gateway:password@cluster.example/
# ROUTE_MONGODB_PRODUCTION_DATABASE=gateway_prod

# Optional named route sources (same profiles and referenced variables on Dashboard).
# ROUTE_SOURCE_PROFILES='[{"id":"preview","name":"Preview routes","driver":"sqlite","connectionEnv":"PREVIEW_SQLITE_PATH","configurationKey":"preview"}]'
# PREVIEW_SQLITE_PATH=/absolute/path/to/data/preview.sqlite
# Stable gateway activation control storage: configure exactly one.
# ROUTE_CONTROL_SQLITE_PATH=/absolute/path/to/data/source-control.sqlite
# ROUTE_CONTROL_POSTGRES_URL=postgresql://gateway:password@localhost/gateway_control
# GATEWAY_INSTANCE_ID=gateway-local

# Dashboard discovers configured storage drivers from the standard ROUTE_SQLITE_PATH,
# ROUTE_POSTGRES_<ENV>_URL, and ROUTE_MONGODB_<ENV>_URI/DATABASE variables.
# ROUTE_SOURCE_PROFILES is only needed for additional named connections/keys.
